{
  "entities": {
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Preferences and profiles of the user",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "professional", "entrepreneur"] },
        "preferredFocusHours": { "type": "string", "enum": ["morning", "afternoon", "evening", "flexible"] },
        "productivityScore": { "type": "number" },
        "email": { "type": "string" }
      },
      "required": ["name", "role", "preferredFocusHours", "productivityScore"]
    },
    "Task": {
      "title": "Task",
      "description": "A productivity task with deadlines and AI analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "category": { "type": "string", "enum": ["student", "professional", "entrepreneur", "personal", "billing", "other"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] },
        "subtasks": { "type": "array" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "riskAnalysis": { "type": "string" },
        "deadlineRisk": { "type": "string", "enum": ["Safe", "Medium Risk", "High Risk", "Critical Risk"] },
        "deadlineRiskExplanation": { "type": "string" },
        "deadlineRiskActions": { "type": "array" },
        "suggestedSchedule": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "deadline", "priority", "category", "status", "createdAt", "updatedAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "A productivity goal containing progress tracker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "targetDate": { "type": "string", "format": "date-time" },
        "progress": { "type": "number" },
        "linkedTasks": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "targetDate", "progress", "linkedTasks", "createdAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "A recurring habit that user tracks for streaks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "frequency": { "type": "string", "enum": ["daily", "weekly"] },
        "streak": { "type": "number" },
        "lastCompleted": { "type": "string" },
        "history": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "frequency", "streak", "history", "createdAt"]
    },
    "AIRecommendation": {
      "title": "AIRecommendation",
      "description": "Active guidance and procrastination-risk coaching recommendation generated by Gemini",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["risk", "schedule", "procrastination", "action"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "taskId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "dismissed", "applied"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "title", "description", "status", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A durable user-AI conversation log message for Coach Chat history (AI History)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "text", "timestamp"]
    },
    "AISchedule": {
      "title": "AISchedule",
      "description": "An AI-generated optimized 7-day work/study schedule",
      "type": "object",
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "items": { "type": "array" },
        "overloadScore": { "type": "number" },
        "analysis": { "type": "string" }
      },
      "required": ["generatedAt", "startDate", "endDate", "items", "overloadScore", "analysis"]
    },
    "AgentLog": {
      "title": "AgentLog",
      "description": "A trace log tracking autonomous agent decisions and actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "actionType": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "taskId": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "success", "warning", "alert"] }
      },
      "required": ["id", "timestamp", "actionType", "title", "description", "severity"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserPreferences",
      "description": "User profile and global preferences doc"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Deadlines and tasks of the user"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "Long-term and short-term goals connected to tasks"
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": "Habit",
      "description": "Streaks and daily/weekly routines tracked by the user"
    },
    "/users/{userId}/recommendations/{recId}": {
      "schema": "AIRecommendation",
      "description": "Proactive coach-led recommendations generated for the user"
    },
    "/users/{userId}/chatHistory/{msgId}": {
      "schema": "ChatMessage",
      "description": "Durable conversation logs with the Coach AI accountability companion (AI History)"
    },
    "/users/{userId}/aiSchedule/{scheduleId}": {
      "schema": "AISchedule",
      "description": "AI-generated optimized calendar schedules"
    },
    "/users/{userId}/agentLogs/{logId}": {
      "schema": "AgentLog",
      "description": "Trace logs of autonomous actions taken by the AI agent"
    }
  }
}
